# Copia este archivo como .env y nunca subas el .env real a Git.

GEMINI_API_KEY=AQ.Ab8RN6LaTHW1mf16h00hMChyeGOJ997cPHgqge6tCYl0-053aw

NODE_ENV=production
PORT=10000

# --- Google Sheets / Apps Script ---
# URL del Web App (implementacion: "Cualquier persona con el enlace")
SHEETS_WEBAPP_URL=
# Poner en 1 solo si instalaste el snippet de REPORTE_VENTAS en Apps Script.
# Si es 0, los reportes se guardan en data/ventas.json (se pierde al reiniciar Render).
REPORTES_DESDE_SHEETS=0

# --- Seguridad ---
# Generalo con:  npm run hash-pin -- 1234
ADMIN_PIN_HASH=
# Generalo con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# --- Reglas de negocio ---
# Comision del vendedor sobre la ganancia (0.30 = 30%)
TASA_COMISION=0.30
# Descuento mayorista plano si no hay tramos (5 = 5%)
DESCUENTO_MAYOR_PCT=5
# Tramos por volumen: "3:8,6:12" => 3+ un. 8% off, 6+ un. 12% off. Tiene prioridad sobre el plano.
MAYOR_TIERS=
STOCK_CACHE_SEG=60

# --- IA (ficha tecnica) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
AI_RATE_LIMIT_POR_MIN=6
