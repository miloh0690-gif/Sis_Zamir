# Plantilla de variables. Copiala a .env en tu maquina.
# NUNCA subas el .env real a Git, y NUNCA pegues llaves reales en este archivo:
# este repositorio es publico y los commits no se pueden deshacer en serio.

NODE_ENV=production
PORT=10000

# --- Google Sheets / Apps Script ---
# URL /exec del Web App, desplegado como "Cualquier persona con el enlace".
# Esta URL NO se publica en la web: solo la usa el servidor de Render.
SHEETS_WEBAPP_URL=
# Secreto compartido con Apps Script. El script lo exige en el header
# X-Api-Key (o en el parametro ?key=). Generalo tu:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHEETS_API_KEY=
# Poner en 1 para que el historial de ventas viva en tu Sheet y no en
# la memoria del servidor (que se pierde cuando Render reinicia).
REPORTES_DESDE_SHEETS=0

# --- Seguridad ---
# Hash scrypt del PIN del dueño. Se genera con: npm run hash-pin -- TU_PIN
ADMIN_PIN_HASH=
# Firma las cookies de sesion. Minimo 16 caracteres.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# --- Reglas de negocio ---
# Comision del vendedor sobre la ganancia (0.30 = 30%)
TASA_COMISION=0.30
# Descuento mayorista plano si no hay tramos (5 = 5%)
DESCUENTO_MAYOR_PCT=5
# Tramos por volumen: "3:8,6:12" => 3+ un. 8% off, 6+ un. 12% off.
# Tiene prioridad sobre el plano para las cantidades que cubre.
MAYOR_TIERS=
STOCK_CACHE_SEG=60

# --- IA (ficha tecnica) ---
# Se configura SOLO como variable de entorno en Render. Nunca aqui.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
AI_RATE_LIMIT_POR_MIN=6