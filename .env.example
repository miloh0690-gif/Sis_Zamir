# Plantilla de variables. Copiala a .env en tu maquina.
#
# ============================================================================
# NO PEGUES NINGUNA LLAVE REAL EN ESTE ARCHIVO.
# Este repositorio es PUBLICO. Todo lo que escribas aqui queda visible para
# cualquiera con un navegador y no se puede borrar de verdad: queda en el
# historial para siempre. Las llaves van unicamente en Render (Environment).
# ============================================================================

NODE_ENV=production
PORT=10000

# --- Google Sheets / Apps Script ---
# URL /exec del Web App, desplegado como "Cualquier persona con el enlace".
# Esta URL NO se publica en la web: solo la usa el servidor de Render.
SHEETS_WEBAPP_URL=

# Secreto compartido entre Render y Apps Script. Render lo manda en el
# parametro ?key= (lecturas) y en el campo apiKey del cuerpo (escrituras).
# Se configura SOLO en Render y en las propiedades del script de Apps Script.
# Valor actual: definido en Render. NO copiarlo aqui.
SHEETS_API_KEY=

# Poner en 1 para que el historial de ventas viva en tu Sheet y no en la
# memoria del servidor (que se pierde cuando Render reinicia).
REPORTES_DESDE_SHEETS=0

# --- Seguridad ---
# Hash scrypt del PIN del dueno: npm run hash-pin -- TU_PIN
ADMIN_PIN_HASH=
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# --- Reglas de negocio ---
TASA_COMISION=0.30
DESCUENTO_MAYOR_PCT=5
# Tramos por volumen: "3:8,6:12" => 3+ un. 8% off, 6+ un. 12% off.
MAYOR_TIERS=
STOCK_CACHE_SEG=60

# --- Ficha tecnica ---
# Base de datos REAL de telefonos. Gratis y SIN llave.
# Es la fuente principal de las especificaciones. Si este servicio cae,
# cambia SPECS_API_URL por otro despliegue o por un dataset propio.
SPECS_API_URL=https://mobile-specs-api-sandy.vercel.app

# GITHUB_TOKEN es opcional. Sin el, los modelos cuyo slug no se puede
# adivinar (Redmi Note 13, Nokia 105, Moto G54, Realme 11...) no se
# encuentran. Con el, la cobertura sube de 8/14 a practicamente todo.
# Token gratis: https://github.com/settings/tokens (sin ningun permiso
# hace falta, solo lecturapublica).
GITHUB_TOKEN=

# Groq solo se usa para redactar los 3 argumentos de venta, tomando las
# especificaciones ya resueltas como unico contexto. Sin esta llave la
# ficha tecnica sigue funcionando, solo sin los argumentos.
# Crear en https://console.groq.com/keys (no pide tarjeta).
#
# OJO: la capacidad gratuita es del MODELO, no de la cuenta.
#   openai/gpt-oss-120b   30 req/min,  1.000 req/dia, 200k tokens/dia
# Un modelo mas grande puede recortarte el dia a 1/14.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_RATE_LIMIT_POR_MIN=8