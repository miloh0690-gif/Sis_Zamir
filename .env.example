# Plantilla de variables. Copiala a .env en tu maquina.
# NUNCA subas el .env real a Git, y NUNCA pegues llaves reales en este
# archivo: este repositorio es publico y los commits no se deshacen.

api gemini=AIzaSyCpflE_4Ji4KQip1hv1a_Qs4U3fn76HEI4
google sheet api=AIzaSyA_HGFUv8-5dvDRaQAxW7aOQagMpbO6MXo

NODE_ENV=production
PORT=10000

# --- Google Sheets / Apps Script ---
# URL /exec del Web App, desplegado como "Cualquier persona con el enlace".
# Esta URL NO se publica en la web: solo la usa el servidor de Render.
SHEETS_WEBAPP_URL=
# Secreto compartido con Apps Script. El script lo exige en el parametro
# ?key= (lecturas) o en el campo apiKey del cuerpo (escrituras).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHEETS_API_KEY=
# Poner en 1 para que el historial de ventas viva en tu Sheet y no en la
# memoria del servidor (que se pierde cuando Render reinicia).
REPORTES_DESDE_SHEETS=0

# --- Seguridad ---
# Hash scrypt del PIN del dueno: npm run hash-pin -- TU_PIN
ADMIN_PIN_HASH=
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# --- Reglas de negocio ---
TASA_COMISION=0.30
DESCUENTO_MAYOR_PCT=5
# Tramos por volumen: "3:8,6:12" => 3+ un. 8% off, 6+ un. 12% off.
MAYOR_TIERS=
STOCK_CACHE_SEG=60

# --- Ficha tecnica ---
# Base de datos REAL de telefonos (datos de GSMArena). Gratis, sin llave.
# Si este servicio cae, cambia SPECS_API_URL por otro despliegue o por
# un dataset propio y no hay que tocar codigo.
SPECS_API_URL=https://mobile-specs-api-sandy.vercel.app

# Solo para los 3 argumentos de venta. Se configura unicamente como
# variable de entorno en Render, nunca aqui.
# Crear en https://console.groq.com/keys (no pide tarjeta).
#
# OJO: la capacidad gratuita es del MODELO, no de la cuenta.
#   openai/gpt-oss-120b   30 req/min,  1.000 req/dia, 200k tokens/dia
#   qwen/qwen3.8-27b      30 req/min,  1.000 req/dia, 200k tokens/dia
# Un modelo mas grande puede recortarte el dia a 1/14.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_RATE_LIMIT_POR_MIN=8
